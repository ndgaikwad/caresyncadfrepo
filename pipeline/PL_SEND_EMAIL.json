{
	"name": "PL_SEND_EMAIL",
	"properties": {
		"activities": [
			{
				"name": "Read all tables status",
				"type": "Lookup",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT * from ctrl.audit_log \nwhere adf_run_id = '@{pipeline().parameters.adf_run_id}'\norder by table_id",
							"type": "Expression"
						},
						"queryTimeout": "02:00:00",
						"partitionOption": "None"
					},
					"dataset": {
						"referenceName": "DS_AzureSqlTable",
						"type": "DatasetReference"
					},
					"firstRowOnly": false
				}
			},
			{
				"name": "Prepare eamil body header",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_header",
					"value": "Ingestion and Transformation process for caresync project has been completed below is status."
				}
			},
			{
				"name": "Prepare eamil body footer",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "body_footer",
					"value": "For any support, please reach out to ndgaikwad@gmial.com"
				}
			}
		],
		"parameters": {
			"adf_run_id": {
				"type": "string",
				"defaultValue": "cbe6cfd1-a6ee-4054-a769-19964d593c7a"
			}
		},
		"variables": {
			"body_header": {
				"type": "String"
			},
			"body_footer": {
				"type": "String"
			}
		},
		"annotations": []
	}
}